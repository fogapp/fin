  # @param [Hash] opts the optional parameters
  # @return [ProcessorLiabilitiesGetResponse]
  #
  # pkg:gem/plaid#lib/plaid/api/plaid_api.rb:12186
  def processor_liabilities_get(processor_liabilities_get_request, opts = T.unsafe(nil)); end

