# Copy to .env for development. dotenv loads it in development and test
# only; production reads the real environment (see INSTALL.md).

DATABASE_USER=fin
DATABASE_PASSWORD=fin
DATABASE_NAME=fin_development
DATABASE_NAME_TEST=fin_test

# Active Record Encryption keys. Integration credentials entered in
# Settings → Integrations are stored encrypted with these, so set them
# before saving any. Generate a set with `bin/rails db:encryption:init`.
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# Provider keys. All optional: each one is only a fallback for a household
# that has saved nothing in Settings → Integrations, which is the supported
# way to configure them (SETUP.md).
#
# Market data
TIINGO_API_KEY=
ALPHA_VANTAGE_API_KEY=
COINMARKETCAP_API_KEY=
COINGECKO_API_KEY=
#
# Plaid (bank, card and brokerage sync). PLAID_ENV is sandbox or production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
#
# Coinbase (Advanced Trade API key), Alchemy (on-chain wallets), RentCast
# (property valuations)
COINBASE_API_KEY_ID=
COINBASE_API_KEY_SECRET=
ALCHEMY_API_KEY=
RENTCAST_API_KEY=
